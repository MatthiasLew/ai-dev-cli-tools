# ==============================================================================
# Production Collector Environment Variables Template
# ==============================================================================
# Copy to .env outside Git and populate with strong random secrets:
#   cp deploy/gce/.env.example /opt/ai-dev-collector/.env
#   chmod 600 /opt/ai-dev-collector/.env
# ==============================================================================

# Strong random password for PostgreSQL (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE

# Database connection URL for the collector (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://telemetry_user:GENERATE_STRONG_RANDOM_PASSWORD_HERE@db:5432/telemetry

# Ingestion rate limiting: token bucket per client IP (bounds: 1 to 10000)
RATE_LIMIT_PER_MINUTE=60

# Max distinct client IP buckets maintained in memory (bounds: 100 to 1000000)
RATE_LIMIT_MAX_ENTRIES=10000

# Retention window for raw telemetry events in days (bounds: 1 to 3650)
RETENTION_DAYS=90

# Maximum request body size in bytes (32 KB, bounds: 1024 to 1048576)
MAX_PAYLOAD_BYTES=32768

# Environment mode: strictly requires PostgreSQL; SQLite is rejected
ENVIRONMENT=production

# Trust reverse proxy X-Forwarded-For header (true when behind Caddy/Nginx)
TRUST_PROXY_HEADERS=true

# Comma-separated list of trusted proxy CIDRs/IPs (Docker bridge and localhost)
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8
